<?xml version="1.0" encoding="UTF-8"?>
<!-- D-27: IDs, class.method and durations only. Never arguments, return values or personal data. -->
<configuration>
    <property name="LOG_PATTERN"
              value="%d{ISO8601} %-5level [%thread] requestId=%X{requestId:--} userId=%X{userId:--} submissionId=%X{submissionId:--} %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR:-logs}/offershield.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR:-logs}/offershield.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Hibernate logs raw SQL error/warning text (e.g. "Duplicate entry 'x@gmail.com'"); the exception still propagates.
         Hibernate 7 uses the org.hibernate.orm.jdbc.* categories; the old class name is kept for safety. -->
    <logger name="org.hibernate.orm.jdbc.error" level="OFF"/>
    <logger name="org.hibernate.orm.jdbc.warn" level="OFF"/>
    <logger name="org.hibernate.engine.jdbc.spi.SqlExceptionHelper" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
