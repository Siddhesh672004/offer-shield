# Copy to .env (git-ignored) and fill in. Never commit real values.

# Google OAuth (P2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost
APP_DOMAIN=
ADMIN_EMAILS=

# Crypto (generate once; back up offline)
TEXT_AES_KEY_BASE64=
INDICATOR_HMAC_PEPPER=

# Data
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
KAFKA_BOOTSTRAP=kafka:9092

# AI (P7)
GROQ_API_KEYS=
AI_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b

# Storage and mail (P5, P3)
CLOUDINARY_URL=
SMTP_USERNAME=
SMTP_APP_PASSWORD=
