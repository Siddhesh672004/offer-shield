# Only Caddy is published. SITE_ADDRESS comes from APP_DOMAIN in .env: empty locally → http://localhost (M-03);
# production sets APP_DOMAIN to the DuckDNS name for automatic HTTPS (P14).
{$SITE_ADDRESS:http://localhost} {
	@app path /api/* /oauth2/* /login/*
	handle @app {
		reverse_proxy app:8080
	}

	# The Angular frontend is routed here from P4.
	handle {
		respond "Not Found" 404
	}
}
