# Only Caddy is published. Locally SITE_ADDRESS defaults to http://localhost (M-03);
# production sets it to the DuckDNS name for automatic HTTPS (P14).
{$SITE_ADDRESS:http://localhost} {
	@app path /api/* /oauth2/* /login/*
	handle @app {
		reverse_proxy app:8080
	}

	# The Angular frontend is routed here from P4.
	handle {
		respond "Not Found" 404
	}
}
