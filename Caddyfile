# Only Caddy is published. SITE_ADDRESS comes from APP_DOMAIN in .env: empty locally → http://localhost (M-03);
# production sets APP_DOMAIN to the DuckDNS name for automatic HTTPS (P14).
{$SITE_ADDRESS:http://localhost} {
	@app path /api/* /oauth2/* /login/*
	handle @app {
		# Uploads: 5 MB file limit in the app (invariant 6); stop larger bodies at the edge.
		@upload path /api/submissions
		request_body @upload {
			max_size 6MB
		}
		# Every other body is a small JSON or form post (P13 N3): at most 1 MB.
		@notUpload not path /api/submissions
		request_body @notUpload {
			max_size 1MB
		}
		reverse_proxy app:8080
	}

	# Everything else is the Angular app (nginx, P4). The app sets these headers on its own
	# responses; these cover the frontend's (D-10 CSP). "defer" applies them after the proxy
	# copies nginx's headers, so they always win.
	# The CSP below must stay identical to CONTENT_SECURITY_POLICY in
	# backend/src/main/java/com/offershield/auth/SecurityConfig.java; CI ("CSP matches") fails if they differ.
	# Browsers ignore HSTS over plain http (local); it takes effect once P14 serves HTTPS.
	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			defer
		}
		reverse_proxy frontend:8080
	}
}
