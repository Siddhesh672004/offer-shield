# Only Caddy is published. SITE_ADDRESS comes from APP_DOMAIN in .env: empty locally → http://localhost (M-03);
# production sets APP_DOMAIN to the DuckDNS name for automatic HTTPS (P14).
{$SITE_ADDRESS:http://localhost} {
	@app path /api/* /oauth2/* /login/*
	handle @app {
		reverse_proxy app:8080
	}

	# Everything else is the Angular app (nginx, P4). The app sets these headers on its own
	# responses; these cover the frontend's (D-10 CSP). "defer" applies them after the proxy
	# copies nginx's headers, so they always win.
	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			defer
		}
		reverse_proxy frontend:8080
	}
}
